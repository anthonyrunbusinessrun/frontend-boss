# Production uses the Supabase primary with sslmode=verify-full and its CA file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/boss

# Required for POST/PATCH/DELETE requests in production.
API_WRITE_TOKEN=replace-with-a-long-random-secret

# Supabase Auth. These settings do not grant browser database access.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
BOSS_APP_ORIGIN=http://localhost:3000
BOSS_ADMIN_EMAILS=admin@example.com

# Optional isolated LOCAL PostgreSQL for tests; never a production URL.
# TEST_DATABASE_URL=postgresql://test_user:test_password@127.0.0.1:5432/postgres
